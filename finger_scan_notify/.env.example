# คัดลอกเป็น .env (git ไม่เก็บ) แล้ว chmod 600 — ห้ามใส่ค่าจริงในไฟล์ .env.example นี้
# ดู SERVER-SETUP-ALMALINUX.md

# production = บังคับมี SECRET_KEY และ HOSOFFICE_* ไม่งั้นแอปไม่ยอมเริ่ม · development = เครื่องพัฒนา
APP_ENV=production

# สร้างด้วย: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# hosoffice (MySQL) — ระบบอ่านอย่างเดียว ทุก connection ถูกบังคับ READ ONLY
# ควรใช้บัญชีที่มีแค่สิทธิ์ SELECT บน fingle_scan, leave_holiday, leave_register, fingle_scan_notify_mute
HOSOFFICE_HOST=
HOSOFFICE_PORT=3306
HOSOFFICE_USER=
HOSOFFICE_PASSWORD=
HOSOFFICE_DATABASE=hosoffice

# ฐานข้อมูลเครื่องสแกน Tigersoft (SQL Server) — อ่านอย่างเดียว ไม่บังคับ
# ใช้ระบุว่า Lost scan เป็นของใคร และเทียบเลขล่าสุดสองฝั่งเพื่อตรวจ "การนำเข้าหยุด" ตลอดวัน
# ควรใช้ login ที่มีสิทธิ์ db_datareader เฉพาะฐานข้อมูลนี้ ; ใส่ IP แทนชื่อเครื่อง (dashboard-srv อาจหาชื่อไม่เจอ)
# ตั้งค่าแล้วรัน: python manage.py tiger-check (จะแสดงชื่อคอลัมน์ให้เลือกใส่ PERSON/MACHINE ด้านล่าง)
TIGER_HOST=
TIGER_PORT=1433
TIGER_DATABASE=TigerWebServerPlus
TIGER_USER=
TIGER_PASSWORD=
# คอลัมน์คนสแกน/เครื่อง (ยืนยันแล้ว) — ไม่ต้องใส่ถ้าใช้ค่านี้ ; ใส่ค่าว่างเพื่อปิดการระบุชื่อ/เครื่อง
TIGER_PERSON_COLUMN=PersonCardID
TIGER_MACHINE_COLUMN=MachID

# 1 = เครื่องหลัก: เริ่ม Monitor และการเตือนเองตอนเปิดแอป — ตั้งได้เครื่องเดียวเท่านั้น (ADR 0001)
# ระหว่างติดตั้ง/ย้ายเครื่องให้เป็น 0 จนกว่าจะหยุดเครื่องเดิมแล้ว
MONITOR_AUTOSTART=0

# waitress ฟังเฉพาะในเครื่อง — nginx ส่งต่อมา
LISTEN_HOST=127.0.0.1
LISTEN_PORT=5050

# Scan importer ตัวใหม่ (หน้า Watch) : off (ค่าเริ่มต้น) | shadow = เทียบเครื่องสแกนกับ hosoffice อย่างเดียว ไม่เขียน hosoffice
# โหมดเขียนยังไม่เปิดให้ตั้ง ; shadow ต้องตั้ง TIGER_* ครบ และต้องกด "ตั้งจุดเริ่มต้น" ที่หน้า Watch ก่อนถึงจะทำงาน
SCAN_IMPORTER_MODE=off
